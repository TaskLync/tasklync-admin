# Tasklync Admin: environment template
# Copy to .env and fill in. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
# Keys are read lazily: a missing one only fails at first login or first service call.

# ─────────────────────────────────────────────
# CORE (required)
# ─────────────────────────────────────────────
NODE_ENV=development

# The SHARED Supabase Postgres database (same one the backend services use)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Supabase root CA (PEM, \n-escaped PEM or base64). Without it TLS is encrypted but the server is not verified.
DATABASE_CA_CERT=
# Force TLS outside production (auto-on for supabase/aws URLs and in production)
DATABASE_SSL=

# Must be the SAME Redis the other services use (Redis >= 6.2)
REDIS_URL=redis://localhost:6379

# Public URL of this panel
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# ─────────────────────────────────────────────
# AUTH SECRETS (required)
# ─────────────────────────────────────────────
# >= 32 bytes. Generate: openssl rand -base64 48
ADMIN_JWT_SECRET=

# Exactly 32 bytes, base64. Generate: openssl rand -base64 32
# Encrypts every admin's TOTP secret and peppers backup codes.
# Every environment that shares one database MUST use the SAME key (copy it from the deployed server).
# Changing or losing it breaks every enrolled MFA: all admins must re-enrol. Back it up separately.
ADMIN_MFA_ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# AUTH TUNING (optional; values shown are the defaults, in seconds unless noted)
# ─────────────────────────────────────────────
ADMIN_ACCESS_TOKEN_TTL=900
ADMIN_SESSION_REMEMBER_TTL=604800
ADMIN_SESSION_SHORT_TTL=28800
ADMIN_TRUSTED_DEVICE_TTL=604800
ADMIN_MFA_TEMP_TOKEN_TTL=300
ADMIN_REFRESH_GRACE_SECONDS=20
ADMIN_MAX_FAILED_ATTEMPTS=5
# minutes
ADMIN_LOCKOUT_MINUTES=30
ADMIN_MAX_CONCURRENT_SESSIONS=3
# Set to false only for local debugging; never in production
ADMIN_MFA_REQUIRED=true

# ─────────────────────────────────────────────
# BACKEND SERVICES
# ─────────────────────────────────────────────
# Production setup (admin on Vercel or a laptop, backend on the VPS):
# every service is reached through the public gateway's admin side door over HTTPS,
# authenticated with GATEWAY_ADMIN_KEY. No per-service internal keys are needed in this mode.
API_GATEWAY_URL=https://api.tasklync.pk
# Must equal GATEWAY_ADMIN_KEY in the api-gateway's environment (min 32 random characters)
GATEWAY_ADMIN_KEY=

# bookings, disputes, coupons, promotions, banners
BOOKING_SERVICE_URL=https://api.tasklync.pk/internal-admin/booking
# verification, moderation, cache, ranking flags
WORKER_SERVICE_URL=https://api.tasklync.pk/internal-admin/worker
# review moderation
REVIEW_SERVICE_URL=https://api.tasklync.pk/internal-admin/review
# reindex, Ranking console, explain
SEARCH_SERVICE_URL=https://api.tasklync.pk/internal-admin/search
# refunds, payout retry
PAYMENT_SERVICE_URL=https://api.tasklync.pk/internal-admin/payment

# Alternative: admin running INSIDE the services' network (same Docker network / VPS).
# Point each URL at the service itself (e.g. http://booking-service:3004) and set the internal keys;
# they must match the services' INTERNAL_API_KEY. INTERNAL_API_KEY is the fallback for all of them.
INTERNAL_API_KEY=
BOOKING_SERVICE_INTERNAL_KEY=
WORKER_SERVICE_INTERNAL_KEY=
REVIEW_SERVICE_INTERNAL_KEY=
SEARCH_SERVICE_INTERNAL_KEY=
PAYMENT_SERVICE_INTERNAL_KEY=

# ─────────────────────────────────────────────
# BEHAVIOUR (optional)
# ─────────────────────────────────────────────
# Live map: public Mapbox token (pk.…)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Read worker locations from Redis for the live map overlay
MAP_USE_REDIS_LOCATION=false
# "Force offline" duration for a worker, minutes (5–1440)
FORCE_OFFLINE_MINUTES=60

# No longer used (safe to delete from old .env files):
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# FCM_* / FIREBASE_*, IMPERSONATION_JWT_SECRET, NEXT_PUBLIC_APP_URL, ADMIN_BOOKING_NOTIFICATIONS
